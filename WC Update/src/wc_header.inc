; Заголовок .WMF для Wild Commander, формат #0A.
; Страница 0 — код, страница 1 — окно записи 16 КиБ модуля vfs.asm (как у
; FTP-плагина), страница 2 — таблица строк списка. Из файла грузится только
; страница 0; страницы 1 и 2 WC лишь резервирует. Заголовок занимает 512 байтов.

        ds 16
        db "WildCommanderMDL"
        db #0A
        db 0
        db 3                          ; всего страниц: код, окно записи, таблица
        db 0                          ; страница 0 подключается по адресу #8000

        ; Первая пара описывает страницу 0: смещение и число 512-байтных секторов
        ; кода с округлением вверх. Остальные пары зарезервированы форматом WMF.
        db 0,(mainEnd-mainStart+511)/512
        db 0,0
        db 0,0
        db 0,0
        db 0,0
        db 0,0

        ds 16
        ds 32*3
        db 0
        dd 0                          ; инструмент меню, не привязанный к выбранному файлу

.plugin_name
        db "ZiFi WC Update v1.0"
        ds 32-($-.plugin_name),' '
        db #03                        ; запуск из меню плагинов
        ds 6
        ds 32                         ; резерв заголовка для плагина типа #03
