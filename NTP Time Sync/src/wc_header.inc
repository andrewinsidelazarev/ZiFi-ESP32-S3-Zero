; Заголовок .WMF для Wild Commander, формат #0A.
; Плагину нужна одна страница: только код, буферов вне окна #8000 у него нет.
; Заголовок физически занимает 512 байтов, код начинается с границы сектора.

        ds 16
        db "WildCommanderMDL"
        db #0A
        db 0
        db 1                          ; всего страниц: только код
        db 0                          ; страница 0 подключается по адресу #8000

        ; Первая пара описывает страницу 0: смещение и число 512-байтных секторов
        ; кода с округлением вверх. Остальные пары зарезервированы форматом WMF.
        db 0,(mainEnd-mainStart+511)/512
        db 0,0
        db 0,0
        db 0,0
        db 0,0
        db 0,0

        ds 16
        ds 32*3
        db 0
        dd 0                          ; не привязан к выбранному файлу

.plugin_name
        db "ZiFi S3 NTP Sync v0.1"
        ds 32-($-.plugin_name),' '
        ; Тип #06 — «выполнить один раз после инициализации Wild Commander».
        ; Этот тип поддерживает Wild Commander Improved; там же описано, как он
        ; обрабатывается. Плагин при таком типе не запускается вручную из меню:
        ; синхронизация часов нужна при старте, а не по требованию.
        db #06
        ds 6
        ds 32                         ; резерв заголовка
