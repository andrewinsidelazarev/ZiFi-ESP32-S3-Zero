; Заголовок .WMF плагина-заставки для Wild Commander (формат #0A).
;
; Первые 512 байт файла WC читает как описание плагина: сколько ему нужно
; страниц памяти, какие блоки файла куда загрузить, как плагин называется и
; когда его вызывать. Сам код лежит в файле сразу после заголовка.
;
; Плагину нужны четыре страницы по 16 КиБ:
;   0 — код и переменные, подключается к #8000;
;   1 — шрифты, круг календаря и малые иконки;
;   2, 3 — иконки погоды.
; Страницы данных лежат в файле следом за кодом, каждая ровно 32 сектора,
; и подключаются к окну #0000 функцией WC MNG0_PL (78).
; Заголовок физически занимает 512 байтов, код начинается с границы сектора.

        ds 16                         ; +0 резерв (WC пишет сюда свои данные)
        db "WildCommanderMDL"          ; +16 подпись формата
        db #0A                        ; +32 версия формата
        db 0
        db 4                          ; всего страниц: код + три страницы данных
        db 0                          ; страница 0 подключается по адресу #8000

        ; Пары «страница, число 512-байтных секторов». Код округляется вверх,
        ; страницы данных занимают ровно 16 КиБ = 32 сектора.
        db 0,(mainEnd-mainStart+511)/512
        db 1,32
        db 2,32
        db 3,32
        db 0,0
        db 0,0

        ds 16
        ds 32*3                       ; расширений нет: плагин не открывает файлы
        db 0
        dd 0                          ; не привязан к выбранному файлу

.plugin_name
        db "ZiFi Weather Saver v0.1"   ; имя в меню плагинов F10
        ds 32-($-.plugin_name),' '
        ; Тип #02 — экранная заставка: WC вызывает плагин сам по таймеру
        ; бездействия (ScreenSaver=N минут в wc.ini) и из меню плагинов F10.
        db #02
        ds 6
        ds 32                         ; резерв заголовка
